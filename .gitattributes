# Default handling for everything: normal text, checked out with LF.
* text=auto eol=lf

# Freeze the vendored BSR2 files byte-for-byte on every platform. This MUST come
# after the catch-all above, because in .gitattributes the LAST matching rule
# wins -- putting it first lets "* text=auto" override it. "-text" disables all
# line-ending conversion so the raw-byte SHA-256 pins in
# tests/test_bsr2_vendor_integrity.py match on Windows and Linux/CI alike.
vendor/** -text