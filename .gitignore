# ==================================================
# The Brisart Ecosystem
# Pure Python / Local First / Dependency Free
# ==================================================

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Type checkers / linters / test caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------------------
# Virtual Environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# OS-generated files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Local Secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env.development
.env.production
.env.test

# BSR2 key material. device_key.json decrypts every biometrics template in its
# data directory, so it must never reach the repository. Listed by name as
# well as by directory in case a data directory is ever relocated.
device_key.json
*.identity

# ---------------------------------------------------------------------------
# Runtime data written by the three application trees
#
# These hold real identity records, sealed biometric templates, verification
# reports, and sealed packages produced by local or CI runs. They are generated
# artefacts containing personal and key material, never source.
# ---------------------------------------------------------------------------
biometrics/data/
packages/data/
vault/data/
*.ibp

# ---------------------------------------------------------------------------
# Generic Cache / Temp / Logs
# ---------------------------------------------------------------------------
.cache/
tmp/
temp/
*.tmp
*.temp
*.lock
logs/
*.log

# ---------------------------------------------------------------------------
# SQLite Databases
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db

# ---------------------------------------------------------------------------
# Project Context Helper
# (shared export tool used across Brisart Ecosystem projects)
# ---------------------------------------------------------------------------
PROJECT_CONTEXT_EXPORTS/
PROJECT_CONTEXT.md
PROJECT_CONTEXT_SETTINGS.json
PROJECT_MANIFEST.json
PROJECT_SUMMARY.txt
PROJECT_SNAPSHOT.zip

# ==================================================
# ArchiveSnapshot
# ==================================================
# Dated snapshot storage created inside archived source folders
ARCHIVE_TIMELINE/
# GUI application settings (per-machine, not part of source)
ARCHIVE_SNAPSHOT_SETTINGS.json
# Headless daily automation config/state/log (per-machine, not source)
DAILY_SNAPSHOT_CONFIG.json
DAILY_SNAPSHOT_STATE.json
DAILY_SNAPSHOT_LOG.md
# Project Context Helper inbox contents (staged files, not source)
SNAPSHOT_ACTIVE/

# ==================================================
# BrisartAI
# ==================================================
# Runtime data
conversation_memory.sqlite3
session_memory.sqlite3
brisart_ai_index.sqlite3
# Exported knowledge archives
exports/
archive_exports/
knowledge_exports/
# Future AI models
models/
downloads/
# Future plugin cache
plugins/cache/
# Future crawl cache
crawl_cache/
web_cache/
# Future scan cache
scan_cache/
